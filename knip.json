{
  "workspaces": {
    ".": {
      "entry": [
        "src/main.ts",
        "vite.config.ts",
        "svelte.config.js",
        "eslint.config.js",
        "playwright.config.ts",
        "tests/**/*.ts",
        "scripts/*.mjs",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.{ts,svelte}",
        "shared/**/*.ts",
        "tests/**/*.ts",
        "scripts/*.mjs",
        "scripts/*.ts"
      ],
      "ignoreDependencies": [
        "tailwindcss"
      ]
    },
    "backend": {
      "entry": [
        "src/app.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
