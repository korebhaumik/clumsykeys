{
  "openapi": "3.1.0",
  "info": {
    "title": "Clumsy Keys account persistence API",
    "version": "1.0.0",
    "description": "Existing guest gameplay and Socket.IO contracts remain unchanged. Account identity comes only from the verified bearer token. Requests have a 1 MiB limit; private responses use Cache-Control: no-store. See persistence.contract.ts for validated settings shapes."
  },
  "servers": [
    {
      "url": "http://localhost:1440"
    }
  ],
  "security": [
    {
      "supabaseBearer": []
    }
  ],
  "paths": {
    "/api/status": {
      "get": {
        "summary": "Check whether accounts are configured",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accounts": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/account": {
      "get": {
        "summary": "Read own profile and preferences",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "displayName": {
                      "type": "string"
                    },
                    "preferences": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/Preferences"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "revision": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/account/preferences": {
      "put": {
        "summary": "Save own preferences using compare-and-swap revision; stale revisions return 409",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "revision": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "preferences",
                  "revision"
                ],
                "properties": {
                  "preferences": {
                    "$ref": "#/components/schemas/Preferences"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/practice-results": {
      "post": {
        "summary": "Save a completed practice session; retries with the same UUID are idempotent; WPM/raw/accuracy/deviation are recomputed",
        "responses": {
          "400": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PracticeSubmission"
              }
            }
          }
        }
      }
    },
    "/api/history": {
      "get": {
        "summary": "Read own history, twenty results per page",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "$ref": "#/components/schemas/PracticeSummary"
                          },
                          {
                            "$ref": "#/components/schemas/RaceResult"
                          }
                        ]
                      }
                    },
                    "nextOffset": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "practice",
                "race"
              ]
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999999,
              "default": 0
            }
          }
        ]
      }
    },
    "/api/practice-results/{id}": {
      "get": {
        "summary": "Read own practice result including chart and word metrics; other owners receive 404",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "summary": {
                      "$ref": "#/components/schemas/PracticeSummary"
                    },
                    "samples": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Sample"
                      }
                    },
                    "history": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Word"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/race-results/{id}": {
      "get": {
        "summary": "Read a round scoreboard as a participant; latest selects own latest round; opponent account IDs are excluded",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "round": {
                      "type": "object"
                    },
                    "ownRacerId": {
                      "type": "string"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request rejected or service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Round UUID or latest"
            }
          }
        ]
      }
    },
    "/api/account/dashboard": {
      "get": {
        "summary": "Read own lifetime saved solo-practice statistics, highest WPM per mode, and five latest tests",
        "description": "Excludes guest, unsaved, abandoned and multiplayer activity. Averages are arithmetic means per saved test. No user ID is accepted; identity comes from the verified bearer token. Best ties use accuracy, recency and ID. Settings and language accompany each best.",
        "responses": {
          "200": {
            "description": "Private dashboard snapshot, including zero counts and empty arrays for a new account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDashboard"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Account service unavailable; retry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/leaderboards/solo": {
      "get": {
        "summary": "Public solo typing leaderboard; optional verified Bearer token adds currentUser rank",
        "security": [
          {},
          {
            "supabaseBearer": []
          }
        ],
        "parameters": [
          {
            "name": "mode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "test",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "length",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "range",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One best result per player, ordered by WPM descending, accuracy descending, date ascending, ID ascending; rows (at most 10), currentUser (or null), total, page and pages. No private settings, email or account UUIDs."
          },
          "400": {
            "description": "Invalid filters"
          },
          "401": {
            "description": "Invalid supplied account token"
          },
          "503": {
            "description": "Unconfigured or unavailable database"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "supabaseBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Preferences": {
        "description": "Validated version 1 preferences; see the browser-safe persistence.contract.ts for field constraints.",
        "type": "object",
        "required": [
          "version",
          "theme",
          "prose",
          "code"
        ],
        "properties": {
          "version": {
            "const": 1
          },
          "theme": {
            "enum": [
              "dark-forest",
              "classic"
            ]
          },
          "prose": {
            "type": "object"
          },
          "code": {
            "type": "object"
          }
        }
      },
      "Sample": {
        "type": "object",
        "required": [
          "seconds",
          "wpm",
          "raw",
          "errors"
        ],
        "properties": {
          "seconds": {
            "type": "number",
            "minimum": 0
          },
          "wpm": {
            "type": "number",
            "minimum": 0
          },
          "raw": {
            "type": "number",
            "minimum": 0
          },
          "errors": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Word": {
        "type": "object",
        "required": [
          "word",
          "wpm",
          "errors"
        ],
        "properties": {
          "word": {
            "type": "string",
            "maxLength": 1000
          },
          "wpm": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "errors": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "PracticeSubmission": {
        "type": "object",
        "required": [
          "id",
          "mode",
          "language",
          "settings",
          "stats"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "enum": [
              "prose",
              "code-snippets",
              "code-keywords"
            ]
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "settings": {
            "type": "object"
          },
          "stats": {
            "type": "object",
            "required": [
              "correct",
              "incorrect",
              "extra",
              "elapsedSeconds",
              "samples",
              "history"
            ],
            "properties": {
              "correct": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "incorrect": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "extra": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "elapsedSeconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 86400
              },
              "samples": {
                "type": "array",
                "maxItems": 86400,
                "items": {
                  "$ref": "#/components/schemas/Sample"
                }
              },
              "history": {
                "type": "array",
                "maxItems": 10000,
                "items": {
                  "$ref": "#/components/schemas/Word"
                }
              }
            }
          }
        }
      },
      "PracticeSummary": {
        "type": "object",
        "required": [
          "id",
          "user_id",
          "mode",
          "language",
          "wpm",
          "accuracy",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "settings": {
            "type": "object"
          },
          "correct": {
            "type": "number",
            "minimum": 0
          },
          "incorrect": {
            "type": "number",
            "minimum": 0
          },
          "extra": {
            "type": "number",
            "minimum": 0
          },
          "elapsed_seconds": {
            "type": "number",
            "minimum": 0
          },
          "wpm": {
            "type": "number",
            "minimum": 0
          },
          "raw": {
            "type": "number",
            "minimum": 0
          },
          "accuracy": {
            "type": "number",
            "minimum": 0
          },
          "deviation": {
            "type": "number",
            "minimum": 0
          },
          "metric_version": {
            "const": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RaceResult": {
        "type": "object",
        "required": [
          "round_id",
          "username",
          "wpm",
          "accuracy",
          "reason",
          "created_at"
        ],
        "properties": {
          "round_id": {
            "type": "string",
            "format": "uuid"
          },
          "participant_id": {
            "type": "string",
            "format": "uuid"
          },
          "account_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "racer_id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "wpm": {
            "type": "number",
            "minimum": 0
          },
          "accuracy": {
            "type": "number",
            "minimum": 0
          },
          "finish_seconds": {
            "type": [
              "number",
              "null"
            ]
          },
          "reason": {
            "enum": [
              "completed",
              "time-limit",
              "disconnected"
            ]
          },
          "speed_history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "wpm": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AccountDashboard": {
        "type": "object",
        "required": [
          "stats",
          "bests",
          "recent"
        ],
        "properties": {
          "stats": {
            "type": "object",
            "required": [
              "tests",
              "seconds",
              "averageWpm",
              "averageRaw",
              "averageAccuracy",
              "bestWpm",
              "characters"
            ],
            "properties": {
              "tests": {
                "type": "integer",
                "minimum": 0
              },
              "seconds": {
                "type": "number",
                "minimum": 0
              },
              "averageWpm": {
                "type": "number",
                "minimum": 0
              },
              "averageRaw": {
                "type": "number",
                "minimum": 0
              },
              "averageAccuracy": {
                "type": "number",
                "minimum": 0
              },
              "bestWpm": {
                "type": "number",
                "minimum": 0
              },
              "characters": {
                "type": "integer",
                "minimum": 0,
                "description": "Total correct, incorrect and extra characters in all saved solo tests."
              }
            }
          },
          "bests": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/PracticeSummary"
            }
          },
          "recent": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "$ref": "#/components/schemas/PracticeSummary"
            }
          }
        }
      }
    }
  }
}
