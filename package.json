{
  "name": "clumsy-keys-official",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dev:server": "npm run dev --prefix backend",
    "build:server": "npm run build --prefix backend",
    "check:server": "npm run check --prefix backend",
    "start:server": "npm run production --prefix backend",
    "lint": "eslint . && node scripts/audit-design.mjs",
    "audit:dead": "knip",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "check:all": "npm run check && npm run check:server && npm run check:docs",
    "check:docs": "node scripts/check-docs.mjs",
    "db:start": "supabase start",
    "test:db": "supabase test db",
    "db:plan": "node scripts/database.mjs --dry-run",
    "db:push": "node scripts/database.mjs --apply",
    "db:types": "node scripts/database.mjs --types",
    "test:integration": "node --import tsx tests/integration/local-supabase.ts",
    "test:simulation": "node --import tsx tests/simulation/accounts.ts",
    "test:hosted": "node --import tsx tests/integration/hosted-supabase.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.8",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "knip": "^6.44.2",
    "supabase": "^3.1.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "socket.io-client": "^4.8.4",
    "svelte-sonner": "^1.2.3",
    "svelte-spa-router": "^5.1.1",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.3"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.12.0 || >=24"
  }
}
