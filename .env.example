# Copy this file to .env in the repository root. Never commit .env.
# The frontend reads VITE_ values at build time. The backend loads root .env
# locally; deployment environment variables take precedence over this file.

# Existing frontend/backend connection settings (local development defaults).
VITE_SERVER_URL=http://localhost:1440
PORT=1440
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173
# Production: set NODE_ENV=production and replace FRONTEND_ORIGINS with exact
# HTTPS frontend origins. Local development origins are not automatically allowed.

# Browser: Supabase project URL and publishable API key (sb_publishable_...).
# Find these in the Supabase project's Connect dialog / API Keys settings.
# VITE_ variables are included in the browser bundle and must be public-safe.
# Vite refuses secret/service-role keys and credential-named VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# GitHub OAuth client ID/secret belong in Supabase Auth > Providers, not VITE_.

# Backend only: same project URL as VITE_SUPABASE_URL, plus a secret API key
# (sb_secret_...) from API Keys settings. Never give this key a VITE_ prefix.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional CLI configuration for migrations; never application runtime keys.
# A saved `supabase login` session replaces SUPABASE_ACCESS_TOKEN.
# The project reference can be derived from the standard Supabase project URL.
# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=
# Optional fallback: the CLI can use a temporary login role without this password.
# SUPABASE_DB_PASSWORD=
