      "function remainderThree(x: number): number {",
      "\treturn x % 3;",
      "}",
      "const values = [-3, 1, 2, 4, 6];",
      "const results = [];",
      "let total = 0;",
      "for (const value of values) {",
      "\tif (value < 0) {",
      "\t\tcontinue;",
      "\t}",
      "\tconst result = remainderThree(value);",
      "\tresults.push(result);",
      "\ttotal += result;",
      "}",
      "console.log(\"Results:\", results);",
      "console.log(\"Count:\", results.length);",
      "console.log(\"Total:\", total);"
    ]
