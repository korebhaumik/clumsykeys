      "import math",
      "def calculate_area(radius):",
      "\tif radius < 0:",
      "\t\treturn \"Invalid radius\"",
      "\telse:",
      "\t\treturn math.pi * math.pow(radius, 2)",
      "print(calculate_area(5))"
