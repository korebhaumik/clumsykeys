    },
    "lines": [
      "def bubble_sort(numbers):",
      "\tfor i in range(len(numbers)):",
      "\t\tfor j in range(len(numbers) - 1):",
      "\t\t\tif numbers[j] > numbers[j + 1]:",
      "\t\t\t\tnumbers[j], numbers[j + 1] = numbers[j + 1], numbers[j]",
      "\treturn numbers",
      "print(bubble_sort([5, 3, 8, 1, 2]))"
    ]
  },
