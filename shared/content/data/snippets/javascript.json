      "function calculateArea(radius) {",
      "\tif (radius < 0) {",
      "\t\treturn \"Invalid radius\";",
      "\t} else {",
      "\t\treturn Math.PI * Math.pow(radius, 2);",
      "\t}",
      "}",
      "console.log(calculateArea(5));"
    ]
