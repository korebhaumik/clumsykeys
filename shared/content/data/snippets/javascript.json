    "length": "long",
    "source": {
      "description": "Migrated from the existing Clumsy Keys catalog; original external provenance is unverified.",
      "url": null
    },
    "lines": [
      "function bubbleSort(numbers) {",
      "\tfor (let i = 0; i < numbers.length; i++) {",
      "\t\tfor (let j = 0; j < numbers.length - 1; j++) {",
      "\t\t\tif (numbers[j] > numbers[j + 1]) {",
      "\t\t\t\t[numbers[j], numbers[j + 1]] = [numbers[j + 1], numbers[j]];",
      "\t\t\t}",
      "\t\t}",
      "\t}",
      "\treturn numbers;",
      "}",
      "console.log(bubbleSort([5, 3, 8, 1, 2]));"
    ]
  },
