    "lines": [
      "function findLongestWord(sentence) {",
      "\tconst words = sentence.split(' ');",
      "\tconst longestWord = words.reduce((longest, currentWord) => currentWord.length > longest.length ? currentWord : longest, '');",
      "\treturn longestWord;",
      "}",
      "console.log(findLongestWord(\"The quick brown fox jumps over the lazy dog\"));"
    ]
  },
