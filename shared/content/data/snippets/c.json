      "\t\tprintf(\"%d\\n\", result);",
      "\t\ttotal += result;",
      "\t\taccepted++;",
      "\t}",
      "\tprintf(\"%d\\n\", accepted);",
      "\tprintf(\"%d\\n\", total);",
      "\treturn 0;",
      "}"
