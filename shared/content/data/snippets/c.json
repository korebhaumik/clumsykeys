      "#include <stdio.h>",
      "#include <string.h>",
      "int main() {",
      "\tchar str[] = \"Hello, World!\";",
      "\tint n = strlen(str);",
      "\tfor (int i = 0; i < n / 2; i++) {",
      "\t\tchar temp = str[i];",
      "\t\tstr[i] = str[n - i - 1];",
      "\t\tstr[n - i - 1] = temp;",
      "\t}",
      "\tprintf(\"Reversed string: %s\\n\", str);",
      "\treturn 0;",
      "}"
    ]
