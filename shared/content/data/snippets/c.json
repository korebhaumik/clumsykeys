      "#include <stdio.h>",
      "int main() {",
      "\tint numbers[] = {5, 3, 8, 1, 2};",
      "\tint n = sizeof(numbers) / sizeof(numbers[0]);",
      "\tfor (int i = 0; i < n - 1; i++) {",
      "\t\tfor (int j = 0; j < n - i - 1; j++) {",
      "\t\t\tif (numbers[j] > numbers[j + 1]) {",
      "\t\t\t\tint temp = numbers[j];",
      "\t\t\t\tnumbers[j] = numbers[j + 1];",
      "\t\t\t\tnumbers[j + 1] = temp;",
      "\t\t\t}",
      "\t\t}",
      "\t}",
      "\tfor (int i = 0; i < n; i++) {",
      "\t\tprintf(\"%d \", numbers[i]);",
      "\t}",
      "\tprintf(\"\\n\");",
      "\treturn 0;",
      "}"
