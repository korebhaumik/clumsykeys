      "\tint total = 0;",
      "\tint accepted = 0;",
      "\tfor (int i = 0; i < count; i++) {",
      "\t\tif (values[i] < 0) {",
      "\t\t\tcontinue;",
      "\t\t}",
      "\t\tint result = remainder_three(values[i]);",
      "\t\tstd::cout << result << std::endl;",
      "\t\ttotal += result;",
      "\t\taccepted++;",
      "\t}",
      "\tstd::cout << accepted << std::endl;",
      "\tstd::cout << total << std::endl;",
      "\treturn 0;",
      "}"
    ]
