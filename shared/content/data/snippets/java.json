    "id": "java-bubble-sort",
    "language": "randomJava",
    "length": "long",
    "source": {
      "description": "Migrated from the existing Clumsy Keys catalog; original external provenance is unverified.",
      "url": null
    },
    "lines": [
      "public class Main {",
      "\tpublic static void main(String[] args) {",
      "\t\tint[] numbers = {5, 3, 8, 1, 2};",
      "\t\tbubbleSort(numbers);",
      "\t\tfor (int number : numbers) {",
      "\t\t\tSystem.out.print(number + \" \");",
      "\t\t}",
      "\t}",
      "\tpublic static void bubbleSort(int[] numbers) {",
      "\t\tfor (int i = 0; i < numbers.length; i++) {",
      "\t\t\tfor (int j = 0; j < numbers.length - 1; j++) {",
      "\t\t\t\tif (numbers[j] > numbers[j + 1]) {",
      "\t\t\t\t\tint temp = numbers[j];",
      "\t\t\t\t\tnumbers[j] = numbers[j + 1];",
      "\t\t\t\t\tnumbers[j + 1] = temp;",
      "\t\t\t\t}",
      "\t\t\t}",
      "\t\t}",
      "\t}",
      "}"
    ]
  },
