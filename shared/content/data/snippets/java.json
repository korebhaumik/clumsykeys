      "\t\t\tint result = remainderThree(value);",
      "\t\t\tSystem.out.println(result);",
      "\t\t\ttotal += result;",
      "\t\t\tcount++;",
      "\t\t}",
      "\t\tSystem.out.println(\"Count: \" + count);",
      "\t\tSystem.out.println(\"Total: \" + total);",
      "\t}",
      "}"
