    "lines": [
      "public class Main {",
      "\tpublic static void main(String[] args) {",
      "\t\tSystem.out.println(findLongestWord(\"The quick brown fox jumps over the lazy dog\"));",
      "\t}",
      "\tpublic static String findLongestWord(String sentence) {",
      "\t\tString[] words = sentence.split(\" \");",
      "\t\tString longestWord = \"\";",
      "\t\tfor (String word : words) {",
      "\t\t\tif (word.length() > longestWord.length()) {",
      "\t\t\t\tlongestWord = word;",
      "\t\t\t}",
      "\t\t}",
      "\t\treturn longestWord;",
      "\t}",
      "}"
