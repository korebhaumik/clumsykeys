    "lines": [
      "class Main {",
      "\tstatic int remainderThree(int x) {",
      "\t\treturn x % 3;",
      "\t}",
      "\tpublic static void main(String[] args) {",
      "\t\tint[] values = {-3, 1, 2, 4, 6};",
      "\t\tint total = 0;",
